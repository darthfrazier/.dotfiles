[user]
	name = karlfrazier
	email = lordkthesith@gmail.com

[core]
	editor = vim
	autocrlf = input

[color]
	ui = auto

[alias]
	st = status
	co = checkout
	br = branch
	lg = log --oneline --graph --decorate --all
	last = log -1 HEAD
	unstage = reset HEAD --
	undo = reset --soft HEAD~1
	aliases = config --get-regexp alias

[pull]
	rebase = false

[push]
	default = current
